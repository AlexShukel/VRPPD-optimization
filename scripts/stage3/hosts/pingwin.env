# Compute host: Ubuntu 24.04 under WSL2, i5-14600KF (20 threads), 27 GB, RTX 4070 SUPER.
SSH_TARGET=pingwin@192.168.50.69
REPO_DIR=VRPPD-optimization
# taskset list for wall-time (timed) runs: set from results/stage3/machine.txt.
TIMED_CPUS=0,2,4,6,8,10
TIMED_THREADS=6
ITER_THREADS=18
# training processes run at once in the b0 and v1 batches (one B0 model is mostly single-core Python)
B0_JOBS=6
V1_JOBS=3
TORCH_INDEX_URL=https://download.pytorch.org/whl/cu124
# 1: bootstrap fails when torch cannot see a GPU; 0 for hosts without one.
REQUIRE_CUDA=1
