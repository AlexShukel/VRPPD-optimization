{
    "name": "problem-gen",
    "version": "1.0.0",
    "description": "Data and problem-instance generator for the VRPPD optimization project.",
    "private": true,
    "scripts": {
        "generate:data": "tsx ./generate-data.ts",
        "generate:problems": "tsx ./generate-problems.ts",
        "generate:problems:small": "tsx ./generate-problems.ts --small",
        "generate:problems:large": "tsx ./generate-problems.ts --large",
        "lint": "eslint .",
        "lint:fix": "eslint . --fix",
        "format": "prettier --write .",
        "format:check": "prettier --check ."
    },
    "engines": {
        "node": "~24.11.0",
        "pnpm": "~10.20.0"
    },
    "packageManager": "pnpm@10.20.0",
    "dependencies": {
        "csv-parser": "^3.2.0",
        "latlon-geohash": "^2.0.0",
        "zod": "^4.1.12"
    },
    "devDependencies": {
        "@eslint/js": "^9.18.0",
        "@types/latlon-geohash": "^2.0.4",
        "@types/node": "^24.10.0",
        "eslint": "^9.18.0",
        "eslint-config-prettier": "^10.0.1",
        "prettier": "^3.6.2",
        "tsx": "^4.20.6",
        "typescript": "^5.9.3",
        "typescript-eslint": "^8.20.0"
    }
}
